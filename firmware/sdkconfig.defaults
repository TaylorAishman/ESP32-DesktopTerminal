# ESP-IDF options for the desktop terminal. Applied on top of ESP-IDF defaults.

# Rust needs more stack than C's defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# 1 ms tick so thread::sleep and timeouts have useful resolution.
CONFIG_FREERTOS_HZ=1000

# 4 MB flash. The partition table itself is in partitions.csv and is written
# by espflash (see espflash.toml).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Keep the device recoverable over USB: no secure boot, no flash encryption
# (REQ-ERR-08). These are ESP-IDF's defaults; stated here so they stay off.
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set

# A thread that stops feeding the task watchdog panics, and the panic
# handler restarts the chip (REQ-ERR-05). Threads register themselves with
# hal_sys_wdt_register; the idle tasks are not watched.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
